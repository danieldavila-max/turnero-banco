{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "turnero": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": { "builder": "@angular/build:application", "options": { "outputPath": "dist/turnero", "index": "src/index.html", "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"], "assets": [{ "glob": "**/*", "input": "public" }] }, "configurations": { "production": { "optimization": true, "outputHashing": "all" } }, "defaultConfiguration": "production" },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "turnero:build" }, "configurations": { "production": { "buildTarget": "turnero:build:production" }, "development": { "buildTarget": "turnero:build" }, "defaultConfiguration": "development" } }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
